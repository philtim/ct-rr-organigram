# Extension key — namespaces the KV-Store entry on the host installation.
# Use a unique suffix on shared dev instances to avoid collisions, e.g. rr-dashboard-pt.
VITE_KEY=rr-dashboard

# For local development against a ChurchTools instance.
VITE_BASE_URL=https://your-instance.church.tools
VITE_USERNAME=
VITE_PASSWORD=
